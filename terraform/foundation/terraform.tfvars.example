# Copy this file to terraform.tfvars and review each value before applying.
region                    = "ap-south-1"
aws_profile               = "zero-to-prod"
project                   = "ztd-capstone"
cluster_name              = "ztd-demo"
cluster_version           = "1.36"
vpc_cidr                  = "10.20.0.0/16"
availability_zone_count   = 3

# Documentation-only address. Replace it with your current public IP plus /32,
# for example: ["YOUR.PUBLIC.IP.ADDRESS/32"]. Never use 0.0.0.0/0.
cluster_endpoint_public_access_cidrs = ["203.0.113.10/32"]

system_node_instance_type = "t3.small"
system_node_desired_size  = 1
system_node_min_size      = 1
system_node_max_size      = 2
