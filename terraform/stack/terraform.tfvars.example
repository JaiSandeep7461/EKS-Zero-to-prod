# Optional stack overrides for the fresh-account foundation.
# Apply terraform/foundation first; the stack reads its cluster/VPC/subnet outputs.
region      = "ap-south-1"
aws_profile = "zero-to-prod"
project     = "ztd-capstone"

node_instance_type = "t3.large"
node_desired_size  = 2
node_min_size      = 2
node_max_size      = 3
node_disk_gib      = 30

sonar_instance_type = "t3.medium"
sonar_disk_gib      = 30

# Public by default for GitHub-hosted SonarQube scans. Restrict to a trusted
# CIDR if your CI runner can reach it through a known static egress IP.
sonar_ingress_cidr = "0.0.0.0/0"

# sonar_db_password left unset -> auto-generated via random_password
